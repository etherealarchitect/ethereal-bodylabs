# Copy to fastlane/.env and fill in — never commit real values.

APPLE_ID=you@example.com
APPLE_TEAM_ID=ABCDE12345
APPLE_ITC_TEAM_ID=

APP_BUNDLE_ID=app.etherealbodylabs.ios

# App Store Connect API Key (App Store Connect → Users and Access → Keys)
APP_STORE_CONNECT_API_KEY_ID=XXXXXXXXXX
APP_STORE_CONNECT_ISSUER_ID=00000000-0000-0000-0000-000000000000
# Base64 of the downloaded AuthKey_*.p8 file:  base64 -i AuthKey_XXXX.p8 | pbcopy
APP_STORE_CONNECT_KEY_CONTENT=

# fastlane match — private repo storing encrypted certs/profiles
MATCH_GIT_URL=git@github.com:your-org/ios-certificates.git
MATCH_PASSWORD=change-me

# CI keychain password (only needed when CI=true)
KEYCHAIN_PASSWORD=change-me

# Optional TestFlight release notes
TESTFLIGHT_CHANGELOG=
