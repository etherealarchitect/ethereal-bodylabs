default_platform(:ios)

XCODE_WORKSPACE = "ios/App/App.xcworkspace"
XCODE_SCHEME    = "App"

platform :ios do
  before_all do
    setup_ci if ENV["CI"]

    app_store_connect_api_key(
      key_id:      ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id:   ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_KEY_CONTENT"],
      is_key_content_base64: true,
      in_house: false,
    )
  end

  desc "Sync signing certificates and provisioning profiles"
  lane :certificates do
    match(type: "appstore")
  end

  desc "Bump build number to the next TestFlight-safe integer"
  lane :bump_build do
    build = latest_testflight_build_number(
      app_identifier: ENV["APP_BUNDLE_ID"],
      initial_build_number: 0,
    ) + 1
    increment_build_number(
      xcodeproj: "ios/App/App.xcodeproj",
      build_number: build,
    )
    UI.success("Build number set to #{build}")
  end

  desc "Build the app and upload to TestFlight"
  lane :beta do
    match(type: "appstore")
    bump_build

    build_app(
      workspace: XCODE_WORKSPACE,
      scheme:    XCODE_SCHEME,
      configuration: "Release",
      export_method: "app-store",
      clean: true,
      output_directory: "build/ios",
      output_name: "EtherealBodylabs.ipa",
      export_options: {
        provisioningProfiles: {
          ENV["APP_BUNDLE_ID"] => "match AppStore #{ENV['APP_BUNDLE_ID']}",
        },
        signingStyle: "manual",
      },
    )

    upload_to_testflight(
      skip_waiting_for_build_processing: true,
      changelog: ENV["TESTFLIGHT_CHANGELOG"] || "Automated build from CI",
      distribute_external: false,
    )
  end

  after_all do
    UI.success("Lane completed successfully.")
  end

  error do |lane, exception|
    UI.error("Lane #{lane} failed: #{exception.message}")
  end
end
